<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.MohamedSalah-13.smart-report-plugin</groupId>
        <artifactId>smart-report-parent</artifactId>
        <version>2.6.0</version>
    </parent>

    <artifactId>smart-report-pdf</artifactId>
    <name>Smart Report PDF</name>
    <description>PDF pages on A4 and A5, right to left or left to right, written and printed with PDFBox alone.</description>

    <properties>
        <automatic.module.name>com.smart.report.pdf</automatic.module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>smart-report-api</artifactId>
        </dependency>
        <!-- Writes the file, draws it back for a preview and hands it to a printer. Apache License 2.0. -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
        </dependency>
        <!-- Encodes the QR code (the PDF draws its squares itself), and reads it back in the tests.
             Apache License 2.0, no dependencies of its own. -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
        </dependency>
    </dependencies>
</project>
